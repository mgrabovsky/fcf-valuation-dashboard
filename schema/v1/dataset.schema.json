{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/fcf-valuation-dashboard/schema/v1/dataset.schema.json",
  "title": "AHP Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "sources",
    "frequency",
    "periods",
    "series",
    "stats"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bea_nipa_table_1_14",
        "fed_z1"
      ],
      "properties": {
        "bea_nipa_table_1_14": {
          "$ref": "#/$defs/beaSource"
        },
        "fed_z1": {
          "$ref": "#/$defs/fedSource"
        }
      }
    },
    "frequency": {
      "type": "string",
      "const": "quarterly"
    },
    "periods": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}Q[1-4]$"
      },
      "minItems": 1
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gva",
        "labor_compensation",
        "taxes_total",
        "gross_investment",
        "cfc",
        "net_investment",
        "fcf",
        "earnings",
        "enterprise_value",
        "capital_replacement_cost",
        "fcf_yield",
        "earnings_yield",
        "ev_gva",
        "k_gva",
        "fcf_gva",
        "labor_share",
        "net_inv_v",
        "net_inv_k",
        "k_v",
        "payout_ratio"
      ],
      "properties": {
        "gva": { "$ref": "#/$defs/levelSeries" },
        "labor_compensation": { "$ref": "#/$defs/levelSeries" },
        "taxes_total": { "$ref": "#/$defs/levelSeries" },
        "gross_investment": { "$ref": "#/$defs/levelSeries" },
        "cfc": { "$ref": "#/$defs/levelSeries" },
        "net_investment": { "$ref": "#/$defs/levelSeries" },
        "fcf": { "$ref": "#/$defs/levelSeries" },
        "earnings": { "$ref": "#/$defs/levelSeries" },
        "enterprise_value": { "$ref": "#/$defs/levelSeries" },
        "capital_replacement_cost": { "$ref": "#/$defs/levelSeries" },
        "fcf_yield": { "$ref": "#/$defs/ratioSeries" },
        "earnings_yield": { "$ref": "#/$defs/ratioSeries" },
        "ev_gva": { "$ref": "#/$defs/ratioSeries" },
        "k_gva": { "$ref": "#/$defs/ratioSeries" },
        "fcf_gva": { "$ref": "#/$defs/ratioSeries" },
        "labor_share": { "$ref": "#/$defs/ratioSeries" },
        "net_inv_v": { "$ref": "#/$defs/ratioSeries" },
        "net_inv_k": { "$ref": "#/$defs/ratioSeries" },
        "k_v": { "$ref": "#/$defs/ratioSeries" },
        "payout_ratio": { "$ref": "#/$defs/ratioSeries" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fcf_yield",
        "earnings_yield",
        "ev_gva",
        "k_gva",
        "fcf_gva",
        "labor_share",
        "net_inv_v",
        "net_inv_k",
        "k_v",
        "payout_ratio"
      ],
      "properties": {
        "fcf_yield": { "$ref": "#/$defs/stats" },
        "earnings_yield": { "$ref": "#/$defs/stats" },
        "ev_gva": { "$ref": "#/$defs/stats" },
        "k_gva": { "$ref": "#/$defs/stats" },
        "fcf_gva": { "$ref": "#/$defs/stats" },
        "labor_share": { "$ref": "#/$defs/stats" },
        "net_inv_v": { "$ref": "#/$defs/stats" },
        "net_inv_k": { "$ref": "#/$defs/stats" },
        "k_v": { "$ref": "#/$defs/stats" },
        "payout_ratio": { "$ref": "#/$defs/stats" }
      }
    }
  },
  "$defs": {
    "numericOrNull": {
      "type": [
        "number",
        "null"
      ]
    },
    "baseSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "unit",
        "values"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/numericOrNull"
          },
          "minItems": 1
        }
      }
    },
    "levelSeries": {
      "allOf": [
        { "$ref": "#/$defs/baseSeries" },
        {
          "properties": {
            "unit": {
              "type": "string",
              "const": "level"
            }
          }
        }
      ]
    },
    "ratioSeries": {
      "allOf": [
        { "$ref": "#/$defs/baseSeries" },
        {
          "properties": {
            "unit": {
              "type": "string",
              "const": "ratio"
            }
          }
        }
      ]
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean",
        "std",
        "min",
        "max"
      ],
      "properties": {
        "mean": { "type": "number" },
        "std": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "beaSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vintage",
        "url"
      ],
      "properties": {
        "vintage": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "fedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vintage",
        "release_quarter",
        "url"
      ],
      "properties": {
        "vintage": {
          "type": "string",
          "format": "date"
        },
        "release_quarter": {
          "type": "string",
          "pattern": "^[0-9]{4}Q[1-4]$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}

